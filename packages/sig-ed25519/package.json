{
  "name": "@docseal/sig-ed25519",
  "version": "0.1.0",
  "description": "DocSeal Ed25519 signature suite and development key provider",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlfors/docseal.git",
    "directory": "packages/sig-ed25519"
  },
  "homepage": "https://github.com/vlfors/docseal/tree/main/packages/sig-ed25519#readme",
  "bugs": {
    "url": "https://github.com/vlfors/docseal/issues"
  },
  "keywords": [
    "docseal",
    "ed25519",
    "signature",
    "did-key"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../LICENSE ../../NOTICE ."
  },
  "dependencies": {
    "@docseal/core": "workspace:*",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
