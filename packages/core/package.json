{
  "name": "@docseal/core",
  "version": "0.3.0",
  "description": "DocSeal core: package format, hashing, Merkle tree, verification pipeline, and plugin interfaces",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlfors/docseal.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/vlfors/docseal/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/vlfors/docseal/issues"
  },
  "keywords": [
    "document",
    "signature",
    "integrity",
    "merkle",
    "verification",
    "opentimestamps",
    "dseal"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../LICENSE ../../NOTICE ."
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "canonicalize": "^5.1.0",
    "fflate": "^0.8.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
