{
  "name": "@docseal/web",
  "version": "0.3.0",
  "private": true,
  "description": "DocSeal in the browser: seal and verify .dseal packages without uploading documents",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@docseal/anchor-ots": "workspace:*",
    "@docseal/core": "workspace:*",
    "@docseal/sig-ed25519": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
