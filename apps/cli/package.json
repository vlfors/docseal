{
  "name": "@docseal/cli",
  "version": "0.1.0",
  "description": "DocSeal command-line interface",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlfors/docseal.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/vlfors/docseal/tree/main/apps/cli#readme",
  "bugs": {
    "url": "https://github.com/vlfors/docseal/issues"
  },
  "keywords": [
    "docseal",
    "document",
    "signature",
    "integrity",
    "opentimestamps",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "docseal": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../LICENSE ../../NOTICE ."
  },
  "dependencies": {
    "@docseal/anchor-ots": "workspace:*",
    "@docseal/core": "workspace:*",
    "@docseal/sig-ed25519": "workspace:*",
    "commander": "^15.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
