{
  "name": "@docseal/mcp",
  "version": "0.2.0",
  "description": "DocSeal MCP server: lets AI agents verify, inspect, and complete DocSeal packages",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlfors/docseal.git",
    "directory": "apps/mcp"
  },
  "homepage": "https://github.com/vlfors/docseal/tree/main/apps/mcp#readme",
  "bugs": {
    "url": "https://github.com/vlfors/docseal/issues"
  },
  "keywords": [
    "docseal",
    "document",
    "signature",
    "integrity",
    "opentimestamps",
    "mcp"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "docseal-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../LICENSE ../../NOTICE ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "canonicalize": "^5.1.0",
    "fflate": "^0.8.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@docseal/anchor-ots": "workspace:*",
    "@docseal/core": "workspace:*",
    "@docseal/node": "workspace:*",
    "@docseal/sig-ed25519": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
