{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docseal.dev/schema/v1/signature.schema.json",
  "title": "DocSeal signature envelope",
  "description": "signatures/NNNN.json (FORMAT-v0.1 §Signature envelope). Signed bytes: UTF8(\"DocSeal/v1/signature\\0\") || SHA-256(JCS(protected)). Unknown properties are allowed and covered by the document hash.",
  "type": "object",
  "required": [
    "protected",
    "value"
  ],
  "properties": {
    "protected": {
      "type": "object",
      "required": [
        "type",
        "version",
        "suite",
        "profile",
        "signer",
        "claimedAt",
        "statementHash",
        "critical"
      ],
      "properties": {
        "type": {
          "const": "docseal-signature"
        },
        "version": {
          "const": 1
        },
        "suite": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "signer": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "claimedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "statementHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attributes": {
          "type": "object"
        },
        "critical": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Critical extensions. A v0.1 verifier returns 'unsupported' for any non-empty list."
        }
      }
    },
    "value": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]*$"
    }
  }
}
