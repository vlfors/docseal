{
  "description": "Golden packages. Verify each offline with no trust policy and only the ed25519 suite and the opentimestamps provider registered; the result must equal 'expected'. Without a chain source a bound anchor is 'unsupported'; an unbound one is 'invalid'.",
  "packages": [
    {
      "file": "valid-basic.dseal",
      "description": "Three files (nested Unicode path, empty file), one signature, no anchor.",
      "expected": {
        "axes": {
          "format": "valid",
          "integrity": "valid",
          "signature": "valid",
          "trust": "not-evaluated",
          "time": "missing",
          "completeness": "full"
        },
        "overall": "indeterminate"
      }
    },
    {
      "file": "valid-single-file.dseal",
      "description": "One file, the smallest possible package.",
      "expected": {
        "axes": {
          "format": "valid",
          "integrity": "valid",
          "signature": "valid",
          "trust": "not-evaluated",
          "time": "missing",
          "completeness": "full"
        },
        "overall": "indeterminate"
      }
    },
    {
      "file": "valid-pending-anchor.dseal",
      "description": "Pending OpenTimestamps anchor bound to the package. Offline, the anchor cannot be confirmed: time is unsupported.",
      "expected": {
        "axes": {
          "format": "valid",
          "integrity": "valid",
          "signature": "valid",
          "trust": "not-evaluated",
          "time": "unsupported",
          "completeness": "incomplete"
        },
        "overall": "indeterminate"
      }
    },
    {
      "file": "tampered-content.dseal",
      "description": "One byte of contract.pdf changed after sealing.",
      "expected": {
        "axes": {
          "format": "valid",
          "integrity": "invalid",
          "signature": "valid",
          "trust": "not-evaluated",
          "time": "missing",
          "completeness": "full"
        },
        "overall": "invalid"
      }
    },
    {
      "file": "forged-manifest.dseal",
      "description": "contract.pdf replaced and its manifest entry recomputed; the statement still names the old manifest.",
